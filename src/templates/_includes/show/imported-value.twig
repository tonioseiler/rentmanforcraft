<div id="{{id}}-field" class="field width-100" data-attribute="{{id}}" data-layout-element="">
    <div class="heading">
        <label id="{{id}}-label" for="{{id}}">{{label}}</label>
    </div>
    <div class="input ltr">
        {% if value is empty %}
            -
        {% elseif value is iterable %}
            <ul>
            {% for k, v in value %}
                <li>
                    {%- if k is not same as(loop.index0) %}<strong>{{ k }}:</strong> {% endif -%}
                    {{- v is iterable ? v|json_encode : v -}}
                </li>
            {% endfor %}
            </ul>
        {% else %}
            {{value|raw|nl2br}}
        {% endif %}
    </div>
</div>